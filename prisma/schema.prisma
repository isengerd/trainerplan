generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  trainer
  player
  guardian
}

enum AttendanceValue {
  yes
  no
  maybe
}

enum MembershipStatus {
  active
  suspended
}

model User {
  id                      String                  @id
  name                    String
  email                   String                  @unique
  passwordHash            String
  role                    Role
  position                String
  number                  Int?
  ballNumber              Int?
  phone                   String                  @default("")
  birthday                DateTime?               @db.Date
  ageGroup                String                  @default("F-Jugend")
  avatar                  String?                 @db.Text
  groupId                 String?
  dribblingRating         Int                     @default(0)
  shootingRating          Int                     @default(0)
  passingRating           Int                     @default(0)
  internalTeam            String?
  activeTeamId            String?
  managedProfile          Boolean                 @default(false)
  loginEnabled            Boolean                 @default(true)
  group                   TeamGroup?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invitations             Invitation[]            @relation("InvitationCreator")
  emailChangeRequests     EmailChangeRequest[]
  responses               AttendanceResponse[]
  sessions                ApiSession[]
  memberships             Membership[]
  coachedTournamentSquads TournamentSquad[]       @relation("TournamentSquadTrainer")
  tournamentAssignments   TournamentSquadPlayer[]
  pushTokens              DevicePushToken[]
  childrenManaged         GuardianPlayer[]        @relation("GuardianAccount")
  guardians               GuardianPlayer[]        @relation("ManagedPlayer")
  invitationsForPlayer    Invitation[]            @relation("InvitationManagedPlayer")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([groupId])
}

model Club {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  licenseType String           @default("single_team")
  memberships Membership[]
  teams       Team[]
  groups      TeamGroup[]
  invitations Invitation[]     @relation("ClubInvitations")
  events      ClubEvent[]
  exercises   ExerciseRecord[]
  configs     AppConfig[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Team {
  id          String           @id @default(cuid())
  clubId      String
  name        String
  ageGroup    String           @default("F-Jugend")
  club        Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]     @relation("TeamInvitations")
  events      ClubEvent[]
  exercises   ExerciseRecord[]
  configs     AppConfig[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([clubId, name])
  @@index([clubId])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  clubId    String
  teamId    String?
  groupId   String?
  role      Role
  clubAdmin Boolean          @default(false)
  status    MembershipStatus @default(active)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team      Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  group     TeamGroup?       @relation("MembershipGroup", fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, clubId, teamId])
  @@index([clubId, status])
  @@index([teamId, status])
  @@index([groupId])
}

model EmailChangeRequest {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  newEmail  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([newEmail])
}

model AgeGroup {
  id        String   @id
  name      String   @unique
  ageRange  String
  sortOrder Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamGroup {
  id          String       @id @default(cuid())
  clubId      String?
  name        String
  description String       @default("")
  color       String       @default("#45d875")
  users       User[]
  memberships Membership[] @relation("MembershipGroup")
  invitations Invitation[]
  club        Club?        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([clubId])
}

model Invitation {
  id              String     @id @default(cuid())
  tokenHash       String     @unique
  email           String
  name            String     @default("")
  role            Role
  ageGroup        String     @default("F-Jugend")
  groupId         String?
  clubId          String?
  teamId          String?
  managedPlayerId String?
  group           TeamGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  club            Club?      @relation("ClubInvitations", fields: [clubId], references: [id], onDelete: Cascade)
  team            Team?      @relation("TeamInvitations", fields: [teamId], references: [id], onDelete: SetNull)
  managedPlayer   User?      @relation("InvitationManagedPlayer", fields: [managedPlayerId], references: [id], onDelete: SetNull)
  invitedById     String
  invitedBy       User       @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime   @default(now())

  @@index([email])
  @@index([groupId])
  @@index([invitedById])
  @@index([managedPlayerId])
}

model GuardianPlayer {
  guardianId String
  playerId   String
  guardian   User     @relation("GuardianAccount", fields: [guardianId], references: [id], onDelete: Cascade)
  player     User     @relation("ManagedPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([guardianId, playerId])
  @@index([playerId])
}

model ClubEvent {
  id                    String                  @id
  clubId                String?
  teamId                String?
  type                  String
  title                 String
  date                  DateTime                @db.Date
  startTime             String
  endTime               String
  location              String
  address               String?
  meetingTime           String
  description           String                  @db.Text
  trainerNote           String?                 @db.Text
  trainerIds            Json                    @default("[]")
  opponent              String?
  homeAway              String?
  competition           String?
  weather               Json?
  maxParticipants       Int
  responses             AttendanceResponse[]
  tournamentSquads      TournamentSquad[]
  tournamentAssignments TournamentSquadPlayer[]
  club                  Club?                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team                  Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([clubId, teamId, date])
}

model TournamentSquad {
  id        String                  @id @default(cuid())
  eventId   String
  event     ClubEvent               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  trainerId String?
  trainer   User?                   @relation("TournamentSquadTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  players   TournamentSquadPlayer[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([eventId])
  @@index([trainerId])
}

model TournamentSquadPlayer {
  squadId   String
  eventId   String
  playerId  String
  squad     TournamentSquad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  event     ClubEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player    User            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@id([squadId, playerId])
  @@unique([eventId, playerId])
  @@index([playerId])
}

model AttendanceResponse {
  eventId   String
  userId    String
  value     AttendanceValue
  event     ClubEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime        @updatedAt

  @@id([eventId, userId])
}

model DevicePushToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.Text
  platform  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ExerciseRecord {
  id        String   @id
  clubId    String?
  teamId    String?
  data      Json
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, teamId])
}

model AppConfig {
  id        String   @id @default("default")
  clubId    String?
  teamId    String?
  settings  Json
  plans     Json
  templates Json
  planMeta  Json
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt

  @@index([clubId, teamId])
}

model ApiSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
