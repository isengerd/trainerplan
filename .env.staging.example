# Separate Vercel project: all values in its Vercel "Production" environment.
# Never copy production credentials or production personal data here.
APP_ENV=staging
PUBLIC_APP_URL=https://staging.nextsession.de
DATABASE_URL=postgresql://USER:PASSWORD@STAGING-ENDPOINT-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
AUTH_PROVIDER=firebase
NEXT_PUBLIC_AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=YOUR-STAGING-FIREBASE-PROJECT
FIREBASE_CLIENT_EMAIL=SERVICE-ACCOUNT@YOUR-STAGING-FIREBASE-PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
AUTH_RATE_LIMIT_SECRET=
# Actual Prisma user ID from the staging database, not a username or Firebase UID.
PLATFORM_ADMIN_USER_IDS=
SEED_DEMO_DATA=false
LICENSE_SELF_SERVICE_ENABLED=false
REGISTRATION_ENABLED=false
CLUB_REGISTRATION_ENABLED=false
# Empty by default: no real messages. Exact, comma-separated test addresses only.
STAGING_EMAIL_ALLOWLIST=
STAGING_PUSH_ENABLED=false
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
